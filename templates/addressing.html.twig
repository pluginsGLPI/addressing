{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    {% if item.isField('name') %}
        {{ fields.autoNameField('name', item, __('Name'), withtemplate, field_options) }}
    {% endif %}

    {% if config.isField('alloted_ip') %}
        {% if item.isField('alloted_ip') %}
            {{ fields.sliderField('alloted_ip', item.fields['alloted_ip'], __('Assigned IP', 'addressing'), field_options) }}
        {% endif %}
    {% else %}
        {{ fields.hiddenField('alloted_ip', 0) }}
    {% endif %}

    {% if item.isField('begin_ip') %}
        {{ _self.ipField('begin_ip', item.fields['begin_ip'], __('First IP', 'addressing')) }}
    {% endif %}

    {% if config.isField('free_ip') %}
        {% if item.isField('free_ip') %}
            {{ fields.sliderField('free_ip', item.fields['free_ip'], __('Free IP', 'addressing'), field_options) }}
        {% endif %}
    {% else %}
        {{ fields.hiddenField('free_ip', 0) }}
    {% endif %}

    {# The empty bytes of the last IP are prefilled by public/scripts/forms.js. #}
    {% if item.isField('end_ip') %}
        {{ _self.ipField('end_ip', item.fields['end_ip'], __('Last IP', 'addressing')) }}
    {% endif %}

    {% if config.isField('double_ip') %}
        {% if item.isField('double_ip') %}
            {{ fields.sliderField('double_ip', item.fields['double_ip'], __('Same IP', 'addressing'), field_options) }}
        {% endif %}
    {% else %}
        {{ fields.hiddenField('double_ip', 0) }}
    {% endif %}

    {% if item.isField('vlans_id') %}
        {{ fields.dropdownField('Vlan', 'vlans_id', item.fields['vlans_id'], 'Vlan'|itemtype_name, field_options|merge({
            'entity': item.fields['entities_id'],
        })) }}
    {% endif %}

    {% if config.isField('reserved_ip') %}
        {% if item.isField('reserved_ip') %}
            {{ fields.sliderField('reserved_ip', item.fields['reserved_ip'], __('Reserved IP', 'addressing'), field_options) }}
        {% endif %}
    {% else %}
        {{ fields.hiddenField('reserved_ip', 0) }}
    {% endif %}

    {{ fields.readOnlyField(
        '',
        item.isNewItem() ? '-' : item.fields['begin_ip'] ~ ' - ' ~ item.fields['end_ip'],
        __('Report for the IP Range', 'addressing')
    ) }}

    {# isField() only tells the column exists, so this test was always true
       and the else branch below - which forces use_ping to 0 when ping is
       disabled - was dead code. Read the stored value instead. #}
    {% if config.fields['use_ping'] %}
        {% if item.isField('use_ping') %}
            {{ fields.sliderField('use_ping', item.fields['use_ping'], __('Use Ping', 'addressing'), field_options) }}
        {% endif %}
    {% else %}
        {{ fields.hiddenField('use_ping', 0) }}
    {% endif %}

    {% if item.isField('comment') %}
        {{ fields.textareaField('comment', item.fields['comment'], _n('Comment', 'Comments', 2), field_options|merge({
            'full_width': true,
        })) }}
    {% endif %}

    {{ fields.smallTitle(_n('Filter', 'Filters', 1, 'addressing'), 'ti ti-alert-circle') }}

    {% if item.isField('networks_id') %}
        {{ fields.dropdownField('Network', 'networks_id', item.fields['networks_id'], 'Network'|itemtype_name, field_options|merge({
            'entity': item.fields['entities_id'],
        })) }}
    {% endif %}

    {% if item.isField('use_as_filter') %}
        {{ fields.sliderField('use_as_filter', item.fields['use_as_filter'], __('Use the networks as filter', 'addressing'), field_options|merge({
            'helper': __('The display of items depends on these criterias', 'addressing'),
        })) }}
    {% endif %}

    {{ fields.smallTitle(__('Default fields for reservation', 'addressing'), 'ti ti-alert-circle') }}

    {% if item.isField('locations_id') %}
        {{ fields.dropdownField('Location', 'locations_id', item.fields['locations_id'], 'Location'|itemtype_name, field_options|merge({
            'entity': item.fields['entities_id'],
        })) }}
    {% endif %}

    {% if item.isField('fqdns_id') %}
        {{ fields.dropdownField('FQDN', 'fqdns_id', item.fields['fqdns_id'], 'FQDN'|itemtype_name, field_options|merge({
            'entity': item.fields['entities_id'],
        })) }}
    {% endif %}
{% endblock %}

{% macro ipField(name, value, label = '', options = {}) %}
    {% set field %}
        {% if value|length == 0 %}
            {% set value = '...' %}
        {% endif %}

        {% set ipexploded = value|split('.') %}
        {% for ipnum in ipexploded %}
            {% if ipnum > 255 %}
                {% set ipexploded = ipexploded|merge({(loop.index0): ''}) %}
            {% endif %}
        {% endfor %}

        <div class="row flex-nowrap">
            <div class="col-auto">
                <input type="text" class="form-control" value="{{ ipexploded[0] }}"
                       name="{{ name }}0" id="{{ name }}0" data-index="0" data-addressing-ip="{{ name }}" size="2" maxlength="3">
            </div>
            <div class="col-auto">
                <input type="text" class="form-control" value="{{ ipexploded[1] }}"
                       name="{{ name }}1" id="{{ name }}1" data-index="1" data-addressing-ip="{{ name }}" size="2" maxlength="3">
            </div>
            <div class="col-auto">
                <input type="text" class="form-control" value="{{ ipexploded[2] }}"
                       name="{{ name }}2" id="{{ name }}2" data-index="2" data-addressing-ip="{{ name }}" size="2" maxlength="3" >
            </div>
            <div class="col-auto">
                <input type="text" class="form-control" value="{{ ipexploded[3] }}"
                       name="{{ name }}3" id="{{ name }}3" data-index="3" data-addressing-ip="{{ name }}" size="2" maxlength="3">
            </div>
        </div>
    {% endset %}

    {{ fields.field(name, field, label, options) }}
{% endmacro %}

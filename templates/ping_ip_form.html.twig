<div class='alert alert-warning'>
    <div class='d-flex'>
        <div class='me-2'>
            {% if error %}
                <i style='color:forestgreen;font-size: 2em;' class='ti ti-circle-check'></i>
            {% else %}
                <i style='color:orange;font-size: 2em;' class='ti ti-alert-triangle'></i>
            {% endif %}
        </div>
        <div>
            <h4>{{ _n('IP address', 'IP addresses', 1) }} : {{ ip }}</h4>
            <div class='text-muted'>
                {% if error %}
                    <span style='color:forestgreen'>&nbsp;{{ __('Ping: no response - free IP', 'addressing') }}</span>
                {% else %}
                    <span style='color:orange'>&nbsp;{{ __('Ping: got a response - used IP', 'addressing') }}</span>
                {% endif %}
            </div>
        </div>
    </div>
</div>

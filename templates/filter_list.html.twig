{% if canedit %}
    <div id="viewfilter{{ item_id }}{{ rand }}"></div>
    <script type='text/javascript'>
        {{ add_button_script|raw }}
    </script>
    <div class='center firstbloc'>
        <a class='submit btn btn-primary me-2' href='javascript:viewAddFilter{{ item_id }}{{ rand }}();'>
            {{ __('Add a filter', 'addressing') }}
        </a>
    </div>
{% endif %}

<div class='spaced'>
    {% if canedit and nb %}
        {{ massiveactions_top|raw }}
    {% endif %}

    {% if nb %}
        <table class="{{ canedit ? 'tab_cadre_fixehov' : 'tab_cadre_fixe' }}">
            <tr class='noHover'>
                <th colspan='{{ (canedit and nb) ? 6 : 5 }}'>{{ _n('Filter', 'Filters', 2, 'addressing') }}</th>
            </tr>
            <tr>
                {% if canedit and nb %}
                    <th width='10'>{{ checkall|raw }}</th>
                {% endif %}
                <th class='center b'>{{ __('Name') }}</th>
                <th class='center b'>{{ __('Entity') }}</th>
                <th class='center b'>{{ __('Type') }}</th>
                <th class='center b'>{{ __('First IP', 'addressing') }}</th>
                <th class='center b'>{{ __('Last IP', 'addressing') }}</th>
            </tr>

            {% for row in rows %}
                <tr class='tab_bg_1'>
                    {% if canedit %}
                        <td width='10'>
                            {{ row.checkbox|raw }}
                            <script type='text/javascript'>
                                {{ row.edit_script|raw }}
                            </script>
                        </td>
                    {% endif %}
                    {% set edit_attr = canedit ? ('style="cursor:pointer" onClick="viewEditFilter' ~ row.id ~ rand ~ '();"') : '' %}
                    <td {{ edit_attr|raw }}>{{ row.name }}</td>
                    <td {{ edit_attr|raw }}>{{ row.entity_name }}</td>
                    <td {{ edit_attr|raw }}>{{ row.type_name }}</td>
                    <td {{ edit_attr|raw }}>{{ row.begin_ip }}</td>
                    <td {{ edit_attr|raw }}>{{ row.end_ip }}</td>
                </tr>
            {% endfor %}

            {% if nb %}
                <tr>
                    {% if canedit and nb %}
                        <th width='10'>{{ checkall|raw }}</th>
                    {% endif %}
                    <th class='center b'>{{ __('Name') }}</th>
                    <th class='center b'>{{ __('Entity') }}</th>
                    <th class='center b'>{{ __('Type') }}</th>
                    <th class='center b'>{{ __('First IP', 'addressing') }}</th>
                    <th class='center b'>{{ __('Last IP', 'addressing') }}</th>
                </tr>
            {% endif %}
        </table>
    {% endif %}

    {% if canedit and nb %}
        {{ massiveactions_bottom|raw }}
        {{ close_form|raw }}
    {% endif %}
</div>

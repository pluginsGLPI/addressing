{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    {% set addressing_url = root_addressing ~ '/ajax/addressing.php' %}

    {# showReservationForm() passes the range under the key "id_addressing"; reading
       "items_id" left the hidden field empty, so every reservation made from this
       form was attached to the range 0 instead of the one being browsed. #}
    {{ fields.hiddenField('plugin_addressing_addressings_id', params['id_addressing']|default(0)) }}

    {% if ping_state in ['cooldown', 'locked'] %}
        <div class='alert alert-info'>
            <i class='ti ti-clock'></i>
            <span>&nbsp;{{ ping_state == 'cooldown'
                ? __('A ping has just been run for this address, please retry in a few seconds', 'addressing')
                : __('A ping is already running, please retry in a few seconds', 'addressing') }}</span>
        </div>
    {% elseif ping_state == 'free' %}
        <div class='alert alert-success'>
            <i class='ti ti-circle-check plugin_addressing_icon_saved'></i>
            <span class='plugin_addressing_icon_saved'>&nbsp;{{ __('Ping: no response - free IP', 'addressing') }}</span>
        </div>
    {% elseif ping_state == 'used' %}
        <div class='alert alert-warning'>
            <i class='ti ti-alert-triangle plugin_addressing_icon_warning'></i>
            <span class='plugin_addressing_icon_warning'>&nbsp;{{ __('Ping: got a response - used IP', 'addressing') }}</span>
        </div>
    {% endif %}

    {% if entities_rights and item.isField('entities_id') %}
        {# The core dropdown reloads the network, location and FQDN fields of the chosen entity. #}
        {{ fields.dropdownField('Entity', 'entities_id', item.fields['entities_id'], 'Entity'|itemtype_name, field_options|merge({
            'toupdate': [
                {
                    'value_fieldname': 'entities_id',
                    'to_update': 'entities_networkip',
                    'url': addressing_url,
                    'moreparams': {'action': 'entities_networkip'},
                },
                {
                    'value_fieldname': 'entities_id',
                    'to_update': 'entities_location',
                    'url': addressing_url,
                    'moreparams': {'action': 'entities_location', 'value': item.fields['locations_id']},
                },
                {
                    'value_fieldname': 'entities_id',
                    'to_update': 'entities_fqdn',
                    'url': addressing_url,
                    'moreparams': {'action': 'entities_fqdn', 'value': item.fields['fqdns_id']},
                },
            ],
        })) }}
    {% endif %}

    {{ fields.readOnlyField('', params['ip'], _n('IP address', 'IP addresses', 1)) }}
    {{ fields.hiddenField('ip', params['ip']) }}

    {{ fields.dropdownArrayField('type', default_type, params['types'], __('Type'), field_options) }}

    {# Checked by public/scripts/forms.js when the name changes. #}
    {{ fields.textField('name_reserveip', '', __('Name'), {
        'id': 'name_reserveip',
        'additional_attributes': {'data-addressing-name-check': addressing_url},
    }) }}

    <div class="alert alert-warning d-none" id="nameUsedItem">
        <i class='ti ti-alert-triangle plugin_addressing_icon plugin_addressing_icon_warning'></i>&nbsp;
        {{ __('Name already in use', 'addressing') }}
    </div>

    <div class="alert alert-success d-none" id="nameNotUsedItem">
        <i class='ti ti-check plugin_addressing_icon plugin_addressing_icon_saved'></i>&nbsp;
        {{ __('Ok you can use this name', 'addressing') }}
    </div>

    {% if item.isField('locations_id') %}
        {{ fields.dropdownField('Location', 'locations_id', item.fields['locations_id'], 'Location'|itemtype_name, field_options|merge({
            'entity': item.fields['entities_id'],
            'container_id': 'entities_location',
        })) }}
    {% endif %}

    {{ fields.dropdownField('State', 'states_id', 0, __('Status'), field_options|merge({
        'entity': item.fields['entities_id'],
    })) }}

    {{ fields.textField('mac', '', __('MAC address'), field_options) }}

    {% if item.isField('fqdns_id') %}
        {{ fields.dropdownField('FQDN', 'fqdns_id', item.fields['fqdns_id'], 'FQDN'|itemtype_name, field_options|merge({
            'entity': item.fields['entities_id'],
            'container_id': 'entities_fqdn',
        })) }}
    {% endif %}

    {# Same markup as IPNetwork::showIPNetworkProperties(), which ajax/addressing.php returns on an entity change. #}
    {{ fields.dropdownField('IPNetwork', 'ipnetworks_id', 0, __('Network'), field_options|merge({
        'entity': item.fields['entities_id'],
        'container_id': 'entities_networkip',
        'toupdate': {
            'value_fieldname': 'ipnetworks_id',
            'to_update': 'show_ipnetwork_' ~ rand,
            'url': config('root_doc') ~ '/ajax/dropdownShowIPNetwork.php',
        },
        'add_field_html': '<span id="show_ipnetwork_' ~ rand ~ '"></span>',
    })) }}

    {% if item.isField('comment') %}
        {{ fields.textareaField('comment', item.fields['comment'], _n('Comment', 'Comments', 2), field_options|merge({
            'full_width': true,
        })) }}
    {% endif %}
{% endblock %}

{% macro ipField(name, value, label = '', options = {}) %}
    {% set field %}
        {% if value|length == 0 %}
            {% set value = '...' %}
        {% endif %}

        {% set ipexploded = value|split('.') %}
        {% for ipnum in ipexploded %}
            {% if ipnum > 255 %}
                {% set ipexploded = ipexploded|merge({(loop.index0): ''}) %}
            {% endif %}
        {% endfor %}

        <div class="row flex-nowrap">
            <div class="col-auto">
                <input type="text" class="form-control" value="{{ ipexploded[0] }}"
                       name="{{ name }}0" id="{{ name }}0" data-index="0" size="2" maxlength="3">
            </div>
            <div class="col-auto">
                <input type="text" class="form-control" value="{{ ipexploded[1] }}"
                       name="{{ name }}1" id="{{ name }}1" data-index="1" size="2" maxlength="3">
            </div>
            <div class="col-auto">
                <input type="text" class="form-control" value="{{ ipexploded[2] }}"
                       name="{{ name }}2" id="{{ name }}2" data-index="2" size="2" maxlength="3" >
            </div>
            <div class="col-auto">
                <input type="text" class="form-control" value="{{ ipexploded[3] }}"
                       name="{{ name }}3" id="{{ name }}3" data-index="3" size="2" maxlength="3">
            </div>
        </div>
    {% endset %}

    {{ fields.field(name, field, label, options) }}
{% endmacro %}

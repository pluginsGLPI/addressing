{% import "components/form/fields_macros.html.twig" as fields %}

{% set field_options = {} %}

{% set bg = "" %}
{% if item.isDeleted() %}
    {% set bg = "asset-deleted" %}
{% endif %}

<div class="asset {{ bg }}">
    {% include("components/form/header.html.twig") %}

    {% set rand = random() %}
    {% set params  = params ?? [] %}
    {% set target       = params['target'] ?? item.getFormURL() %}
    {% set withtemplate = params['withtemplate'] ?? "" %}

    <div class="card d-flex flex-wrap">
        <div class="col-12 flex-column card-body">
            <div class="d-flex flex-row flex-wrap flex-xl-nowrap">
                <div class="row flex-row align-items-start flex-grow-1">
                    <div class="row flex-row">

                        <div class="form-field row align-items-center col-12 col-sm-6 mb-2">
                            <label class="col-form-label col-xxl-3 text-xxl-end ">
                                {{ __('Ping result', 'addressing') }}
                            </label>
                            <div class="col-xxl-9 field-container">
                                {% if ping_state == 'unknown' %}
                                    <i class="ti ti-question plugin_addressing_icon plugin_addressing_icon_warning"
                                       title="{{ __('Automatic action has not be launched', 'addressing') }}"></i><br>
                                    {{ __('Ping informations not available', 'addressing') }}
                                {% else %}
                                    <i class="ti {{ ping_state == 'ok' ? 'ti-square-check plugin_addressing_icon_ok' : 'ti-square-x plugin_addressing_icon_ko' }} plugin_addressing_icon"
                                       title="{{ __('Last ping attempt', 'addressing') }} : {{ ping_date }}"></i><br>
                                    {{ __('Last ping attempt', 'addressing') }} : {{ ping_date }}<br>
                                    {{ __('IP') }}&nbsp;{{ ping_ip }}
                                {% endif %}
                            </div>
                        </div>

                        <div class="form-field row align-items-center col-12 col-sm-6 mb-2">
                            <label class="col-form-label col-xxl-5 text-xxl-end ">
                                {{ _x('button','Manual launch of ping','addressing') }}
                            </label>
                            <div class="col-xxl-7 field-container">
                                {# The ping form is loaded below by public/scripts/forms.js. #}
                                <button form="" class="btn btn-primary btn-sm" type="button"
                                        title="{{ _x('button', 'Manual launch of ping', 'addressing') }}"
                                        data-addressing-ping-form="{{ ping_form }}"
                                        data-addressing-ping-target="ping_item"
                                        data-addressing-items-id="{{ items_id }}"
                                        data-addressing-itemtype="{{ itemtype }}">
                                    <i class='ti ti-terminal-2 plugin_addressing_icon'></i>
                                </button>
                            </div>
                        </div> {# .row #}

                        <div id='ping_item' class="d-none form-field row align-items-center col-12 col-sm-12 mb-2">
                        </div>

                    </div> {# .row #}
                </div> {# .flex-row #}
            </div>
            <div class="col-3 flex-column">
                <div class="flex-row asset-pictures">
                    {#                {% include("components/form/pictures.html.twig") with {'gallery_type': ''} %} #}
                </div>
            </div>
        </div> {# .card-body #}
    </div>
